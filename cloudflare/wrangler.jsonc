{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-lab",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "account_id": "ad2b681fa1b22ac434d9fc4d5e69bc7c"
}
