# Optional environment overrides; never commit a real key.
# Configure endpoint, model and token prices through the app Settings page.
# Leave blank to store a key through Settings in the private local secret file.
TRADING_LAB_API_KEY=
# scripts/dev.sh always uses local SQLite and ignores DATABASE_URL.
# On macOS, the default local storage is ~/Library/Application Support/Trading Lab.
# .env.local can override these values for this computer.
# TRADING_LAB_LOCAL_DIR=/absolute/path/to/local-storage
# TRADING_LAB_DB=/absolute/path/trading-lab.sqlite3
# TRADING_LAB_SECRET_FILE=/absolute/path/secrets.json
# TRADING_LAB_MARKET_KEY_FILE=/absolute/path/market-data.key

